# --- Sentry ---
# DSN from your Sentry project (Settings → Projects → [project] → Client Keys).
# Safe to expose to the browser; used by client, server and edge runtimes.
NEXT_PUBLIC_SENTRY_DSN="https://<key>@o<org-id>.ingest.de.sentry.io/<project-id>"

# Org and project slugs — used at BUILD time to upload source maps.
SENTRY_ORG="your-org-slug"
SENTRY_PROJECT="your-project-slug"

# Auth token for uploading source maps (CI / production builds only).
# Create at: Sentry → Settings → Auth Tokens (scope: project:releases).
# Keep this SECRET — do not expose to the browser.
SENTRY_AUTH_TOKEN=""
